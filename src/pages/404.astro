---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="La página que buscás no existe o cambió de dirección." noindex={true}>
  <section class="not-found"><div class="wrap"><span class="kicker">Error 404</span><h1 class="display">Esta ruta no llega<br /><em>a destino.</em></h1><p class="lede" style="margin-inline:auto">Volvé al inicio o explorá nuestras guías para continuar.</p><div class="hero-actions" style="justify-content:center"><a class="btn btn--ink" href="/">Ir al inicio</a><a class="btn btn--ghost" href="/guias">Ver guías</a></div></div></section>
</BaseLayout>
